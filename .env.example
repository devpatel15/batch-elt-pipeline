# Copy this file to .env before running `docker compose up`.

# Host UID Airflow containers run as (avoids permission issues on Linux
# bind mounts; harmless default on Windows/macOS).
AIRFLOW_UID=50000

# Airflow webserver login (Phase 2).
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Slack incoming webhook for failure alerts (dags/alerts.py). Optional -
# failures are logged instead of alerted if this is unset.
SLACK_WEBHOOK_URL=

# BigQuery project (Phase 3+). Service account key lives at secrets/gcp-service-account.json,
# mounted read-only into the containers by docker-compose.yml.
GCP_PROJECT_ID=

# Metabase admin login (Phase 5), used by scripts/setup_metabase.py.
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=
